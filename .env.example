# SIGAP Web GIS 1.0 — Environment Variables Configuration
# Copy this file to .env.local and update with your actual Supabase credentials

VITE_APP_TITLE=SIGAP Aceh Utara
VITE_APP_VERSION=1.0.0

# Supabase Configuration (Optional - Application falls back to verified offline data store if unset)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# BMKG API Base
VITE_BMKG_API_URL=https://api.bmkg.go.id/publik/prakiraan-cuaca

# BNPB InaRISK GIS Base
VITE_INARISK_GIS_URL=https://gis.bnpb.go.id/server/rest/services/inarisk
